# Maintainer: NordicNode <support@nordicnode.com>
pkgname=mcpforge
pkgver=0.1.0
pkgrel=1
pkgdesc="The fast, zero-runtime TUI that discovers every MCP client on your machine and syncs them all"
arch=('x86_64' 'aarch64')
url="https://github.com/nordicnode/mcpforge"
license=('MIT')
makedepends=('cargo' 'git')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/nordicnode/mcpforge/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${pkgname}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --bin mcpforge
}

package() {
    cd "${pkgname}-${pkgver}"
    install -Dm755 "target/release/mcpforge" "${pkgdir}/usr/bin/mcpforge"
    install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
