{
  "autoUpdates": true,
  "telemetry": false,
  "theme": "dark",
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {
        "FETCH_TIMEOUT": "30"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/mikey/Desktop"
      ]
    }
  },
  "model": "claude-3-7-sonnet"
}
